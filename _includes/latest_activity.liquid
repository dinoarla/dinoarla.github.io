<div class="latest-activity-list">
  {% if site.news != blank %}
    {% assign shown_items = site.news | sort: 'date' | reverse %}

    {% assign years = '' | split: '|' %}
    {% for item in shown_items %}
      {% assign yr = item.date | date: '%Y' %}
      {% unless years contains yr %}
        {% assign years = years | push: yr %}
      {% endunless %}
    {% endfor %}

    {% for year in years %}
      <div class="notes-year-group{% unless forloop.first %} notes-year-hidden{% endunless %}">
        <div class="notes-year-header">
          <span class="notes-year-label">{{ year }}</span>
        </div>

        {% for item in shown_items %}
          {% assign item_year = item.date | date: '%Y' %}
          {% if item_year == year %}
            <div class="notes-row">
              <span class="notes-date">{{ item.date | date: '%b %d' }}</span>
              <div class="notes-content">
                {% if item.inline %}
                  {{ item.content | emojify }}
                {% else %}
                  <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endfor %}

    {% if years.size > 1 %}
      <div class="notes-year-toggle">
        <button class="notes-show-more" onclick="activityShowNextYear(this)" data-lang="{{ page.lang }}">
          {% if page.lang == 'id' %}Tampilkan {{ years[1] }}{% else %}Show {{ years[1] }}{% endif %}
        </button>
        <button class="notes-show-less" onclick="activityShowLess(this)" data-lang="{{ page.lang }}" style="display: none">
          {% if page.lang == 'id' %}Tampilkan lebih sedikit{% else %}Show less{% endif %}
        </button>
      </div>
    {% endif %}

    <div class="notes-footer">
      {% if page.lang == 'id' %}
        <a href="/news/" class="notes-view-all">Lihat semua aktivitas &rarr;</a>
      {% else %}
        <a href="{{ '/news/' | relative_url }}" class="notes-view-all">View all activity &rarr;</a>
      {% endif %}
    </div>
  {% else %}
    <p>No activity so far...</p>
  {% endif %}
</div>

<script>
  function activityShowNextYear(btn) {
    var container = btn.closest('.latest-activity-list');
    var hidden = container.querySelectorAll('.notes-year-hidden');
    if (hidden.length === 0) return;

    hidden[0].classList.remove('notes-year-hidden');
    var remaining = container.querySelectorAll('.notes-year-hidden');
    var lessBtn = container.querySelector('.notes-show-less');
    lessBtn.style.display = 'inline-block';

    if (remaining.length === 0) {
      btn.style.display = 'none';
    } else {
      var nextYear = remaining[0].querySelector('.notes-year-label').textContent;
      btn.textContent = (btn.dataset.lang === 'id' ? 'Tampilkan ' : 'Show ') + nextYear;
    }
  }

  function activityShowLess(btn) {
    var container = btn.closest('.latest-activity-list');
    var groups = container.querySelectorAll('.notes-year-group');
    groups.forEach(function (group, i) {
      if (i > 0) group.classList.add('notes-year-hidden');
    });

    var moreBtn = container.querySelector('.notes-show-more');
    if (groups.length > 1) {
      var nextYear = groups[1].querySelector('.notes-year-label').textContent;
      moreBtn.textContent = (moreBtn.dataset.lang === 'id' ? 'Tampilkan ' : 'Show ') + nextYear;
      moreBtn.style.display = 'inline-block';
    }
    btn.style.display = 'none';
  }
</script>
